# Sample environment configuration for mywhisper/myw

# Required paths
MYW_DATA_DIR=/absolute/path/to/myw-data
MYW_DB_PATH=/absolute/path/to/myw-data/myw.db
MYW_PODCAST_CACHE_PATH=/absolute/path/to/Apple/Podcasts/cache

# Pipeline configuration
MYW_WHISPER_MODEL=/absolute/path/to/ggml-base.bin
MYW_LOG_LEVEL=INFO

# Optional overrides
# MYW_DEVICE=cuda
# MYW_OLLAMA_MODEL=llama3
# MYW_SPACY_MODEL=en_core_web_sm
# MYW_HF_TOKEN=your_hf_token

